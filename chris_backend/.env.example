# CHRIS Backend Environment Configuration
# Copy this file to .env and fill in your actual values

# === Supabase Configuration ===
# REQUIRED: These must be set for the backend to connect to Supabase
# Get these from your Supabase project settings > API
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_KEY=your_supabase_anon_key_here

# Optional: Service role key for admin operations (keep secret!)
# SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# === CORS Configuration ===
# Frontend origin for CORS policy (defaults to "*" if not set)
# In production, set this to your actual frontend URL
FRONTEND_ORIGIN=https://your-frontend-domain.com

# === ML Model Configuration (Optional) ===
# Paths to trained LSTM and U-Net models (.pkl or .onnx format)
# If not set, the backend will use pre-computed predictions from Supabase

# Path to LSTM model for temporal flood risk prediction
# LSTM_MODEL_PATH=/path/to/lstm_model.pkl

# Path to U-Net model for spatial sponge zone segmentation
# UNET_MODEL_PATH=/path/to/unet_model.onnx

# === Application Configuration ===
# API server host and port (for uvicorn)
HOST=0.0.0.0
PORT=3001

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# === Database Connection Pool (Advanced) ===
# Supabase handles connection pooling internally
# These are optional tuning parameters
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=10
